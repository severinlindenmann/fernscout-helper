{
  "contentModel": 1,
  "files": {
    "config.json": {
      "what": "who this journal belongs to, and what it switches on",
      "api": "POST /api/v1/journals to create, PATCH /api/v1/{user}/config to change",
      "keys": {
        "ownerName": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            },
            {
              "assert": "never-in-file"
            }
          ],
          "note": "owner.name in the file"
        },
        "ownerNickname": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            },
            {
              "assert": "never-in-file"
            }
          ],
          "note": "owner.nickname in the file"
        },
        "username": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            },
            {
              "assert": "never-in-file"
            }
          ],
          "note": "the folder name is the username \u2014 the API asks for it, the file does not carry it"
        },
        "title": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            },
            {
              "assert": "required"
            }
          ]
        },
        "owner": {
          "asserts": [
            {
              "assert": "type",
              "type": "object"
            },
            {
              "assert": "required"
            },
            {
              "assert": "never-over-api"
            }
          ],
          "note": "{ name, nickname, email } \u2014 the API takes ownerName and ownerNickname instead, and the address from the signup"
        },
        "tagline": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            }
          ],
          "tip": "a line under the title on the front page"
        },
        "visibility": {
          "asserts": [],
          "tip": "whether this instance advertises the journal at all. Absent reads as public"
        },
        "startLocation": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            }
          ],
          "tip": "where the maps open before a trip has begun"
        },
        "defaultLocale": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            },
            {
              "assert": "required"
            }
          ]
        },
        "locales": {
          "asserts": [
            {
              "assert": "type",
              "type": "array"
            },
            {
              "assert": "required"
            }
          ],
          "note": "every language the journal is written in"
        },
        "baseCurrency": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            }
          ],
          "tip": "what totals are converted into"
        },
        "displayCurrencies": {
          "asserts": [
            {
              "assert": "type",
              "type": "array"
            }
          ],
          "tip": "the currencies shown beside the base one"
        },
        "units": {
          "asserts": []
        },
        "manualRates": {
          "asserts": [
            {
              "assert": "type",
              "type": "object"
            }
          ],
          "tip": "rates the ECB does not publish, as units per euro"
        },
        "features": {
          "asserts": [
            {
              "assert": "type",
              "type": "object"
            }
          ],
          "tip": "what this journal switches on \u2014 /api/health lists what this server can offer, and why anything off is off"
        },
        "travellers": {
          "asserts": [
            {
              "assert": "type",
              "type": "array"
            },
            {
              "assert": "never-over-api"
            }
          ],
          "tip": "how the walking figures are drawn when a trip does not say. There is no API call for the journal's default party \u2014 it is read from this file, and a trip's own travellers: block is set through \u2026/trips/<trip>/travellers"
        },
        "media": {
          "asserts": [
            {
              "assert": "type",
              "type": "object"
            },
            {
              "assert": "never-over-api"
            }
          ],
          "note": "this journal's upload allowance; may narrow the server's, never widen it"
        }
      },
      "rules": [
        {
          "assert": "known-key",
          "path": "*"
        }
      ]
    },
    "trip.md": {
      "what": "the trip itself. Frontmatter, then the intro prose as the body",
      "api": "POST /api/v1/{user}/trips",
      "keys": {
        "id": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            },
            {
              "assert": "required"
            },
            {
              "assert": "pattern",
              "pattern": "^[a-z0-9][a-z0-9-]*$",
              "expected": "lowercase letters, digits and hyphens"
            }
          ],
          "note": "must equal the folder name"
        },
        "title": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            },
            {
              "assert": "required"
            }
          ]
        },
        "start": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            },
            {
              "assert": "pattern",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "expected": "a date like 2026-06-24"
            },
            {
              "assert": "required"
            }
          ],
          "note": "a trip without start and end is skipped at every reading path"
        },
        "end": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            },
            {
              "assert": "pattern",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "expected": "a date like 2026-06-24"
            },
            {
              "assert": "required"
            }
          ]
        },
        "tagline": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            }
          ],
          "tip": "one line under the trip's title"
        },
        "intro": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            },
            {
              "assert": "never-in-file"
            }
          ],
          "body": true,
          "note": "the prose under the frontmatter; the API calls it intro"
        },
        "status": {
          "asserts": [],
          "tip": "which trip the journal opens on"
        },
        "accent": {
          "asserts": [],
          "tip": "the trip's colour"
        },
        "visibility": {
          "asserts": [],
          "tip": "who may read it. private = only the people who were there; guest = everyone let into the journal. An unreadable value reads as private, never public"
        },
        "listed": {
          "asserts": [
            {
              "assert": "type",
              "type": "boolean"
            }
          ],
          "tip": "false keeps a public trip out of the sitemap, the feed and the switcher. It only ever narrows"
        },
        "costsVisibility": {
          "asserts": [],
          "tip": "who may see what it cost, once they can read the trip at all"
        },
        "test": {
          "asserts": [],
          "noTip": true,
          "note": "content nobody lived, written to prove the pipeline works. It says so in a banner"
        },
        "people": {
          "asserts": [
            {
              "assert": "type",
              "type": "array"
            }
          ],
          "tip": "who was on the trip \u2014 up to ten, each a name and an email. They may write to it, and it is who the trip is credited to"
        },
        "travellers": {
          "asserts": [
            {
              "assert": "type",
              "type": "array"
            }
          ],
          "tip": "how the party is drawn on this trip"
        },
        "rates": {
          "asserts": [
            {
              "assert": "type",
              "type": "object"
            }
          ],
          "tip": "the rates this trip's money was actually changed at, as units per euro"
        },
        "tracks": {
          "asserts": [
            {
              "assert": "type",
              "type": "object"
            }
          ],
          "tip": "what this trip keeps track of \u2014 costs, location, photos. Absent means all of them, and a day missing one is refused"
        },
        "translations": {
          "asserts": [
            {
              "assert": "type",
              "type": "object"
            }
          ],
          "tip": "the title, tagline and intro in the journal's other languages"
        },
        "cover": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            },
            {
              "assert": "never-over-api"
            }
          ],
          "tip": "a photograph from the trip for the index and the OG image. It cannot be set at create time \u2014 the media does not exist yet"
        }
      },
      "rules": [
        {
          "assert": "known-key",
          "path": "*"
        }
      ]
    },
    "entries/YYYY-MM-DD-slug.md": {
      "what": "one update. Several per day is normal",
      "api": "POST /api/v1/{user}/trips/{trip}/days, then \u2026/days/{slug}/publish",
      "keys": {
        "title": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            },
            {
              "assert": "required"
            }
          ]
        },
        "date": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            },
            {
              "assert": "pattern",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "expected": "a date like 2026-06-24"
            },
            {
              "assert": "required"
            }
          ],
          "note": "must match the filename, and fall inside the trip"
        },
        "content": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            },
            {
              "assert": "required"
            }
          ],
          "body": true,
          "note": "the prose \u2014 the markdown after the frontmatter"
        },
        "time": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            },
            {
              "assert": "pattern",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "expected": "24-hour, like 18:40"
            }
          ],
          "tip": "orders several updates that share a date"
        },
        "location": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            }
          ],
          "tip": "where this was"
        },
        "country": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            }
          ],
          "tip": "the country's name, not its code"
        },
        "countryCode": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            },
            {
              "assert": "pattern",
              "pattern": "^[A-Z]{2}$",
              "expected": "two capitals, like PT"
            }
          ],
          "tip": "draws the flag"
        },
        "lat": {
          "asserts": [
            {
              "assert": "type",
              "type": "number"
            }
          ],
          "tip": "where it goes on the map"
        },
        "lng": {
          "asserts": [
            {
              "assert": "type",
              "type": "number"
            }
          ]
        },
        "transportMode": {
          "asserts": [],
          "tip": "how you arrived; draws the leg from the previous day"
        },
        "transportFrom": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            }
          ]
        },
        "transportTo": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            }
          ]
        },
        "travelScene": {
          "asserts": [],
          "tip": "how the travel scene into this day plays"
        },
        "tags": {
          "asserts": [
            {
              "assert": "type",
              "type": "array"
            }
          ],
          "tip": "lowercase words joined by single hyphens"
        },
        "costs": {
          "asserts": [
            {
              "assert": "type",
              "type": "array"
            }
          ],
          "tip": "what this day cost, each line in the currency it was spent in"
        },
        "test": {
          "asserts": [],
          "noTip": true,
          "note": "content nobody lived, written to prove the pipeline works"
        },
        "translations": {
          "asserts": [
            {
              "assert": "type",
              "type": "object"
            }
          ],
          "tip": "the title and prose in the journal's other languages. Required when the journal declares more than one"
        },
        "without": {
          "asserts": [
            {
              "assert": "type",
              "type": "array"
            },
            {
              "assert": "never-over-api"
            }
          ],
          "note": "what this day deliberately has none of \u2014 written by sending e.g. costs: false"
        },
        "unrecorded": {
          "asserts": [
            {
              "assert": "type",
              "type": "array"
            },
            {
              "assert": "never-over-api"
            }
          ],
          "note": "what this day had and nobody wrote down \u2014 written by sending e.g. costs: \"unknown\". A different statement from `without`, and kept apart on purpose: there was none against there was some and it is gone"
        },
        "weather": {
          "asserts": [
            {
              "assert": "never-in-file"
            }
          ],
          "offerable": true,
          "note": "ask the server to look up what the weather was"
        },
        "weatherData": {
          "asserts": [
            {
              "assert": "never-in-file"
            }
          ],
          "note": "a reading somebody actually took"
        },
        "coordinates": {
          "asserts": [
            {
              "assert": "never-in-file"
            }
          ],
          "note": "only ever false \u2014 this day has no one place"
        },
        "photos": {
          "asserts": [
            {
              "assert": "never-in-file"
            }
          ],
          "note": "only ever false \u2014 this day has no photographs"
        },
        "idempotency_key": {
          "asserts": [
            {
              "assert": "never-in-file"
            }
          ],
          "note": "names one write, so a retry is safe"
        },
        "gallery": {
          "asserts": [
            {
              "assert": "type",
              "type": "array"
            },
            {
              "assert": "never-over-api"
            }
          ],
          "note": "the photographs. Not part of the day's body over the API \u2014 POST them to \u2026/media"
        },
        "cover": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            },
            {
              "assert": "never-over-api"
            }
          ]
        },
        "status": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            },
            {
              "assert": "enum",
              "enum": [
                "draft"
              ]
            },
            {
              "assert": "never-over-api"
            }
          ],
          "note": "publishing is a separate call, never a field"
        },
        "slug": {
          "asserts": [
            {
              "assert": "type",
              "type": "string"
            },
            {
              "assert": "never-over-api"
            }
          ],
          "note": "the slug the instance assigned when publish.mjs first wrote this day \u2014 recorded here the way a trip's own id: records its folder name, so a later retitle does not lose the day. Written by publish.mjs itself after every write; never sent, and not something to set by hand."
        }
      },
      "rules": [
        {
          "assert": "known-key",
          "path": "*"
        }
      ]
    },
    "costs.md": {
      "what": "the budget and what was spent before leaving. Optional",
      "api": "PUT /api/v1/{user}/trips/{trip}/costs",
      "optional": true,
      "tip": "no costs.md \u2014 a trip with a budget shows how the spending is tracking against it",
      "keys": {
        "budget": {
          "asserts": [
            {
              "assert": "type",
              "type": "object"
            }
          ],
          "tip": "{ total, days, currency } \u2014 what the trip was expected to cost"
        },
        "costs": {
          "asserts": [
            {
              "assert": "type",
              "type": "array"
            }
          ],
          "tip": "flights, accommodation and anything else paid before leaving"
        }
      },
      "rules": [
        {
          "assert": "known-key",
          "path": "*"
        }
      ]
    },
    "plan.md": {
      "what": "the planned route, for a trip that has not happened yet. Optional",
      "api": "not over the API today \u2014 write the file",
      "optional": true,
      "tip": "an upcoming trip with no plan.md shows no route on its map",
      "keys": {
        "route": {
          "asserts": [
            {
              "assert": "type",
              "type": "array"
            }
          ],
          "tip": "the stops, each with a location:"
        }
      },
      "rules": [
        {
          "assert": "known-key",
          "path": "*"
        }
      ]
    }
  },
  "shapes": {
    "cost": {
      "keys": [
        "label",
        "amount",
        "currency",
        "category"
      ],
      "rules": [
        {
          "assert": "known-key",
          "path": "*"
        }
      ]
    },
    "gallery": {
      "keys": [
        "src",
        "type",
        "width",
        "height",
        "caption",
        "poster",
        "from"
      ],
      "rules": [
        {
          "assert": "known-key",
          "path": "*"
        }
      ]
    }
  },
  "named": [
    {
      "id": "day-answers-tracked-fields",
      "kind": "named",
      "because": "needs the trip's tracks: and the day's without:/unrecorded: together"
    },
    {
      "id": "journal-declares-locales-day-needs-translations",
      "kind": "named",
      "because": "needs the journal's locales: and the day's translations: together"
    }
  ]
}
